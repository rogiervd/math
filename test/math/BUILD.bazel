load("@rules_cc//cc:defs.bzl", "cc_test")

[
    cc_test(
        name = test_name,
        size = "small",
        srcs = [test_name + ".cpp"],
        deps = [
            "//:math",
            "@boost.test//:unit_test_main",
        ],
    )
    for test_name in [
        "test-alphabet",
        "test-cost",
        "test-generalise_type",
        "test-lexicographical-2-viterbi",
        "test-lexicographical-4-hash",
        "test-log-float-alone",
        "test-log-float-hash",
        "test-log-float-limits",
        "test-log-float",
        "test-magma",
        "test-max_semiring",
        "test-product-1-operations",
        "test-product-1-spot",
        "test-product-4-hash",
        "test-sequence-4-hash",
        "test-sequence-integration-alphabet",
    ]
]

# The long-double test does not work in all environments, so it is separate.
# The normal version is above.
cc_test(
    name = "test-log-float-long-double",
    size = "small",
    srcs = ["test-log-float.cpp"],
    args = [
        "--",
        "--with-long-double",
    ],
    deps = [
        "//:math",
        "@boost.test//:unit_test_main",
    ],
)

